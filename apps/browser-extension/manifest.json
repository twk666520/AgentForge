
{
  "manifest_version": 3,
  "name": "AgentForge",
  "version": "0.1.0",
  "description": "AI Agent Enhancement Platform - Browser Companion",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgentForge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
